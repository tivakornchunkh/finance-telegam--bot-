# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
AUTHORIZED_TELEGRAM_USER_ID=your_telegram_user_id_here

# AI Configuration (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Google Sheets Configuration
GOOGLE_SHEET_ID=your_google_spreadsheet_id_here
# Path to service account JSON key file (e.g., ./credentials/service-account.json)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json

# Timezone Configuration
TIMEZONE=Asia/Bangkok

# Bot Settings Defaults
DEFAULT_ACCOUNT=K PLUS
REMINDER_TIME=20:00
SECOND_REMINDER_TIME=22:00

